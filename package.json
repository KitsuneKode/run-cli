{
  "name": "run-cli",
  "version": "0.1.0",
  "description": "A lightweight Bun-native CLI for running projects through local profiles and smart detection.",
  "type": "module",
  "private": true,
  "module": "src/cli.ts",
  "bin": {
    "run": "src/bin/run.ts",
    "runx": "src/bin/run.ts"
  },
  "files": ["src", "docs", "README.md"],
  "engines": {
    "bun": ">=1.3.9"
  },
  "scripts": {
    "dev": "bun run src/bin/run.ts",
    "build": "mkdir -p dist && bun build src/bin/run.ts --outfile dist/cli.js --target bun",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome check . && markdownlint-cli2 README.md docs/**/*.md",
    "format": "biome format --write . && markdownlint-cli2 --fix README.md docs/**/*.md",
    "check": "bun run lint && bun test",
    "link:global": "bun link",
    "unlink:global": "bun unlink",
    "relink:global": "bun run src/scripts/relink-global.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/bun": "latest",
    "@biomejs/biome": "^1.9.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "markdownlint-cli2": "^0.18.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
