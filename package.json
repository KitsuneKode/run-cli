{
  "name": "@kitsunekode/run-cli",
  "version": "0.1.0",
  "description": "A lightweight Bun-native CLI for running projects through local profiles and smart detection.",
  "keywords": [
    "bun",
    "cli",
    "profiles",
    "run",
    "runner",
    "shell",
    "terminal"
  ],
  "homepage": "https://github.com/KitsuneKode/run-cli#readme",
  "bugs": {
    "url": "https://github.com/KitsuneKode/run-cli/issues"
  },
  "license": "MIT",
  "author": "kitsunekode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KitsuneKode/run-cli.git"
  },
  "bin": {
    "run": "bin/run"
  },
  "files": [
    "bin/run",
    "dist/run.js",
    "completions",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run src/bin/run.ts",
    "build": "mkdir -p dist && bun build src/bin/run.ts --minify --outfile dist/run.js --target node",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome check . && markdownlint-cli2 README.md docs/**/*.md",
    "format": "biome format --write . && markdownlint-cli2 --fix README.md docs/**/*.md",
    "typecheck": "bunx tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun test",
    "pkg:check": "bun run build && npm pack --dry-run --ignore-scripts",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "link:global": "bun run build && bun link",
    "unlink:global": "bun unlink",
    "relink:global": "bun run src/scripts/relink-global.ts",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check && bun run build",
    "prepare": "[ -f .git/config ] && [ -w .git/config ] && husky || echo 'Skipping husky install (no writable .git config)'"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/bun": "1.3.14",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "markdownlint-cli2": "^0.22.1"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.3.9"
  }
}
